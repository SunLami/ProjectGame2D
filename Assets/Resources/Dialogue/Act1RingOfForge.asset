  _dialogueId: dialogue.act1.ring_of_forge
  _initialNodeId: greeting
  _nodes:
  - _nodeId: greeting
    _speakerName: Merric
    _portrait: {fileID: 0}
    _text: So you're the one Oswin's been talking about. Come, let me show you
      the forge -- every blade in this town starts right here. Take this Gold
      Bar as a welcome gift; the Smithing Station is yours to use now. There's...
      someone else in town you should meet, if you're not easily spooked. Ask
      around for the merchant who deals in stranger things.
    _nextNodeId:
    _outcomeId: visit
    _choices: []
