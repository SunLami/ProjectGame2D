  _nodes:
  - _nodeId: greeting
    _speakerName: Fruits Trader
    _portrait: {fileID: 0}
    _text: Sweet, ripe, and picked this morning. I also buy back what you grow, if
      you're farming.
    _nextNodeId: 
    _outcomeId: 
    _choices:
    - _text: Show me your goods.
      _nextNodeId: shop_leaf
    - _text: Just looking, thanks.
      _nextNodeId: leave_leaf
  - _nodeId: shop_leaf
    _speakerName: Fruits Trader
    _portrait: {fileID: 0}
    _text: Seeds to plant, or crops to sell -- your choice.
    _nextNodeId: 
    _outcomeId: commerce.shop
    _choices: []
  - _nodeId: leave_leaf
    _speakerName: Fruits Trader
    _portrait: {fileID: 0}
    _text: Come back anytime.
    _nextNodeId: 
