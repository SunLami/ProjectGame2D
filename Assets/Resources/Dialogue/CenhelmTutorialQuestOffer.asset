  _dialogueId: dialogue.town.elder.tutorial_offer
  _initialNodeId: greeting
  _nodes:
  - _nodeId: greeting
    _speakerName: Cenhelm
    _portrait: {fileID: 0}
    _text: Ah, a new face. Before you go looking for adventure out there, you ought
      to learn your way around here first.
    _nextNodeId: offer
    _outcomeId:
    _choices: []
  - _nodeId: offer
    _speakerName: Cenhelm
    _portrait: {fileID: 0}
    _text: Go speak with our blacksmith, trade a little, and gather what you need.
      Prove you can stand on your own two feet in this village.
    _nextNodeId:
    _outcomeId: elder.tutorial.offered
    _choices: []
