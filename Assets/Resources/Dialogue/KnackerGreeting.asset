  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14c148da086a4444f9dc223cd131312a, type: 3}
  m_Name: KnackerGreeting
  m_EditorClassIdentifier: ProjectGame2D.Runtime::DialogueDefinition
  _dialogueId: dialogue.forest.knacker.greeting
  _initialNodeId: greeting
  _nodes:
  - _nodeId: greeting
    _speakerName: Knacker
    _portrait: {fileID: 0}
    _text: Back from the hunt? I trade in bones and slime, and I can grind bones into ash.
    _nextNodeId:
    _outcomeId:
    _choices:
    - _text: Show me your goods.
      _nextNodeId: shop
    - _text: I'd like to craft Bone Ash.
      _nextNodeId: craft
    - _text: Just passing by.
      _nextNodeId: leave
  - _nodeId: shop
    _speakerName: Knacker
    _portrait: {fileID: 0}
    _text: Take a look. I buy and sell Slime, Bone and Bone Ash.
    _nextNodeId:
    _outcomeId: commerce.shop
    _choices: []
  - _nodeId: craft
    _speakerName: Knacker
    _portrait: {fileID: 0}
    _text: One bone makes three portions of Bone Ash.
    _nextNodeId:
    _outcomeId: commerce.crafting
    _choices: []
  - _nodeId: leave
    _speakerName: Knacker
    _portrait: {fileID: 0}
    _text: Good hunting.
    _nextNodeId:
    _outcomeId: 
    _choices: []
