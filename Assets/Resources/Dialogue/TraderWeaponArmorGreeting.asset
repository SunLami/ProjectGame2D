  m_Script: {fileID: 11500000, guid: 14c148da086a4444f9dc223cd131312a, type: 3}
  m_Name: TraderWeaponArmorGreeting
  m_EditorClassIdentifier: ProjectGame2D.Runtime::DialogueDefinition
  _dialogueId: dialogue.town.trader_weapon_armor.greeting
  _initialNodeId: greeting
  _nodes:
  - _nodeId: greeting
    _speakerName: Weapon & Armor Trader
    _portrait: {fileID: 0}
    _text: Steel, leather, and a little bit of luck -- that is what keeps you alive
      out there. What can I do for you?
    _nextNodeId: 
    _outcomeId: 
    _choices:
    - _text: Show me your wares.
      _nextNodeId: shop_leaf
    - _text: I would like to craft something.
      _nextNodeId: craft_leaf
    - _text: Just looking, thanks.
      _nextNodeId: leave_leaf
  - _nodeId: shop_leaf
    _speakerName: Weapon & Armor Trader
    _portrait: {fileID: 0}
    _text: Take your time -- everything here is battle-ready.
    _nextNodeId: 
    _outcomeId: commerce.shop
    _choices: []
  - _nodeId: craft_leaf
    _speakerName: Weapon & Armor Trader
    _portrait: {fileID: 0}
    _text: Bring me the materials and I will forge it at the station.
    _nextNodeId: 
    _outcomeId: commerce.crafting
    _choices: []
  - _nodeId: leave_leaf
    _speakerName: Weapon & Armor Trader
    _portrait: {fileID: 0}
    _text: Safe travels out there.
    _nextNodeId: 
    _outcomeId: 
    _choices: []
