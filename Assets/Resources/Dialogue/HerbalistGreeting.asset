MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 14c148da086a4444f9dc223cd131312a, type: 3}
  m_Name: HerbalistGreeting
  m_EditorClassIdentifier: ProjectGame2D.Runtime::DialogueDefinition
  _dialogueId: dialogue.forest.herbalist.greeting
  _initialNodeId: greeting
  _nodes:
  - _nodeId: greeting
    _speakerName: Edyth
    _portrait: {fileID: 0}
    _text: Welcome. I trade in herbs and brew potions for the road.
    _nextNodeId:
    _outcomeId:
    _choices:
    - _text: Show me your goods.
      _nextNodeId: shop
    - _text: I'd like to brew a potion.
      _nextNodeId: craft
    - _text: Just passing by.
      _nextNodeId: leave
  - _nodeId: shop
    _speakerName: Edyth
    _portrait: {fileID: 0}
    _text: I buy and sell healing herbs, mana herbs, and potions.
    _nextNodeId:
    _outcomeId: commerce.shop
    _choices: []
  - _nodeId: craft
    _speakerName: Edyth
    _portrait: {fileID: 0}
    _text: Bring the right herbs and ingredients, and we can brew a potion.
    _nextNodeId:
    _outcomeId: commerce.crafting
    _choices: []
  - _nodeId: leave
    _speakerName: Edyth
    _portrait: {fileID: 0}
    _text: Safe travels.
    _nextNodeId:
    _outcomeId: 
    _choices: []
