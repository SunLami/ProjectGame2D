  _destinations:
  - id: boss.earth
    displayName: Earth Golem
    description: A sealed stone courtyard guarded by a golem of living rock. Slam,
      spikes, falling stone and a shockwave ultimate.
    sceneName: BossArena_Earth
    spawnId: arena_entry
    available: 1
    icon: {fileID: 21300000, guid: 2abf819a9280f4b4092030d59a247925, type: 3}
    accent: {r: 0.85, g: 0.62, b: 0.25, a: 1}
  - id: boss.water
    displayName: Tidal Crab
    description: A tidal beach where an armoured crab burrows, spits bubbles and
      calls the sea. The water rises and falls as you fight.
    sceneName: BossArena_Water
    spawnId: arena_entry
    available: 1
    icon: {fileID: 43314580731449232, guid: 4dc2df8b3d5eb7f419bd757f67b51cb3, type: 3}
    accent: {r: 0.3, g: 0.6, b: 0.95, a: 1}
  - id: boss.wind
    displayName: Sky Owl
    description: A cross-shaped terrace floating above a sea of clouds. The owl shrine
      and the arena are ready; the guardian is not awake yet.
    sceneName: BossArena_Wind
    spawnId: arena_entry
    available: 1
    icon: {fileID: 0}
    accent: {r: 0.7, g: 0.85, b: 0.9, a: 1}
  _ui: {fileID: 676210325}
  _title: BOSS TELEPORT
  _subtitle: Choose a sealed arena to enter.
  _lockWhileFighting: {fileID: 0}
