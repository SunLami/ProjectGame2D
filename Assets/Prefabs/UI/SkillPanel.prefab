  m_Script: {fileID: 11500000, guid: ab00f30c6a8e23a4799384901bd847a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ProjectGame2D.Runtime::SkillPanelUI
  _window: {fileID: 1065257205666609573}
  _tooltip: {fileID: 8774051203742952072}
  _title: {fileID: 7346999416170748751}
  _description: {fileID: 2472004020907841480}
  _cost: {fileID: 2937349744180944523}
  _close: {fileID: 4696438365897277968}
  _entries:
  - id: skill.water.spiral_bolt
    displayName: Spiral Water Bolt
    description: Launch a spiraling water projectile.
    learningCost: 2
    button: {fileID: 2023752872673438474}
  - id: skill.water.vortex
    displayName: Water Vortex
    description: Create a damaging water vortex that slows enemies and pulls them
      toward its dark center.
    learningCost: 3
    button: {fileID: 5160565612096126814}
  - id: skill.water.spiral_beam
    displayName: Spiral Water Beam
    description: Fire a sustained spiral water beam while rooted in place.
    learningCost: 4
    button: {fileID: 2344016409315217053}
  - id: skill.water.threefold_tsunami
    displayName: Threefold Tsunami
    description: Unleash three increasingly powerful waves, culminating in a water
      dragon and final water blast.
    learningCost: 5
    button: {fileID: 428501493862890110}
  - id: skill.earth.rock_bolt
    displayName: Rock Bolt
    description: Launch an angular boulder.
    learningCost: 2
    button: {fileID: 8301650268984502119}
  - id: skill.earth.rock_arena
    displayName: Rock Arena
    description: Raise a pillar arena that traps, slows and weakens enemies, with
      stunning spikes inside.
    learningCost: 3
    button: {fileID: 6943472221629389900}
  - id: skill.earth.spike_field
    displayName: Rock Spike Field
    description: Erupt a forward fan of damaging stone spikes that stun and root
      enemies.
    learningCost: 4
    button: {fileID: 6488725510405608855}
  - id: skill.earth.meteor_storm
    displayName: Meteor Storm
    description: Call down flaming rocky meteors with explosive impacts.
    learningCost: 5
    button: {fileID: 9167504163807412902}
  - id: skill.wind.returning_blade
    displayName: Returning Wind Blade
    description: Throw a crescent wind blade that damages enemies on its outward
      and return paths.
    learningCost: 2
    button: {fileID: 7919544230479478475}
  - id: skill.wind.whirlwind
    displayName: Whirlwind
    description: Summon a moving whirlwind that lifts enemies, then drops and stuns
      them.
    learningCost: 3
    button: {fileID: 3530085125437307133}
  - id: skill.wind.gale_fan
    displayName: Gale Fan
    description: Release three pushing gusts in a forward fan. Wall collisions deal
      bonus damage and stun.
    learningCost: 4
    button: {fileID: 903191717260168020}
  - id: skill.wind.roc
    displayName: Wind Roc
    description: Summon a diving wind roc that carries and throws enemies into a
      shockwave, leaving a slowing aftermath.
    learningCost: 5
    button: {fileID: 7510536260744314143}
  _catalog: {fileID: 11400000, guid: bf5da158363fb8f4a8427f430fc8a043, type: 2}
